# Runner working state — per-host and per-attempt: leases, claims, flock files and
# the append-only ledger. Evidence about a run on one machine, not shared history.
.runner-state/
.runner-logs/

# Generated output. runs/ and bench/results.md are reproducible from a seed, and
# committing them would make the compression numbers look like fixtures.
runs/
bench/results.md
*.sqlite

__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# Virtualenvs. The unattended writer builds one inside its worktree to run the
# test suite — 205 MB of it — and a `git add -A` would commit the lot into a
# public repo, where it is in history from then on. Ignored here rather than left
# to each agent to notice, because "remember not to commit it" is not a mechanism.
.venv/
venv/
env/
ENV/
.tox/
