# Runner working state — per-host and per-attempt: leases, claims, flock files and
# the append-only ledger. Evidence about a run on one machine, not shared history.
.runner-state/
.runner-logs/

# Generated output. runs/ and bench/results.md are reproducible from a seed, and
# committing them would make the compression numbers look like fixtures.
runs/
bench/results.md
*.sqlite

__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store
